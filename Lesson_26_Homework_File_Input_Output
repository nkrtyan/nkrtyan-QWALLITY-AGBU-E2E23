import os

def delete_file():
    i = 65
    count = 0
    while i <= 90:
        filename = chr(i) + ".txt"
        if os.path.exists(filename):
            os.remove(filename)
            count+=1
        i+=1
    print(f"Deleted {count} files")    
delete_file()




