# Lesson_22: Python Collections-> List, Tuple
# Create python script  which will implement min and sort method algorithm.
# Do not use ready max(), min(),  sort() functions


my_list = [1, 5, 8, -2, 10]
new_list = []

for i in range(len(my_list)):
    min_value = my_list[0]
    for item in my_list:
        if item < min_value:
            min_value = item
    new_list.append(min_value)
    my_list.remove(min_value)        

print(new_list)